=== Basic String aggregation ===
{"a":1,"b":2,"c":3}
=== Basic JSON type aggregation ===
{"a":1,"b":2,"c":3}
=== Mixed String/JSON inputs ===
{"a":1,"b":2,"c":3}
=== Null deletion ===
{"a":1,"c":3}
=== Nested objects ===
{"a.b":1,"a.c":2,"a.d":3}
=== Value replacement ===
{"a":3}
=== Arrays ===
{"arr":[4,5,6]}
=== GROUP BY ===
group1	{"a":1,"b":2}
group2	{"x":10,"y":20}
=== Empty objects ===
{"a":1}
=== SimpleAggregateFunction ===
1	{"age":30,"name":"Alice"}
2	{"age":25,"name":"Bob"}
=== SimpleAggregateFunction with String input ===
1	{"city":"NYC","country":"USA"}
2	{"city":"London","country":"UK"}
=== SimpleAggregateFunction with null deletion ===
1	{"a":1,"c":3}
=== Result casting ===
{"a":1,"b":2}
